  <activity android:name="com.monte.montrix.MainActivity" android:screenOrientation="landscape" android:exported="true"/>
  <activity android:name="com.monte.montrix.RadioActivity" android:label="Radio" android:icon="@drawable/radio_art" android:exported="true" android:excludeFromRecents="true"/>
  <activity android:name="com.monte.montrix.MusicActivity" android:label="Music" android:icon="@drawable/music_art" android:exported="true" android:excludeFromRecents="true"/>
  <activity android:name="com.monte.montrix.ToggleActivity" android:exported="true" android:excludeFromRecents="true"/>
